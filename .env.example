# Адрес HTTP-API бэкенда. Без слэша в конце.
# Локально (бэкенд в том же Codespace/машине):
VITE_API_URL=http://localhost:8000/api

# Если бэкенд в отдельном Codespace (порт 8000 сделан Public):
# VITE_API_URL=https://<backend-codespace-name>-8000.app.github.dev/api

# В продакшене:
# VITE_API_URL=https://api.example.com/api